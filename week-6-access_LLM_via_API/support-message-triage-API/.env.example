LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
LLM_ENABLED=true

# In-memory cache for repeated /triage requests.
# Cache is keyed by sha256(PROMPT_VERSION + user_text), so bumping the
# prompt version in src/llm/service.py invalidates every entry.
TRIAGE_CACHE_SIZE=256
TRIAGE_CACHE_TTL_SECONDS=3600
